{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {

      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:l}{NewLine}{Exception}"
        }
      }
    ]
  },

  "Loom": {
    "RoutePrefix": "loom",

    "Backends": {
      "backend-a": {
        "Host": "localhost",
        "Port": 5237
      }
    },

    "Routes": [
      {
        "PathTemplate": "helloworld",
        "Upstream": {
          "Name": "backend-a",
          "PathTemplate": "helloworld"
        }
      }
    ]
  }
}
